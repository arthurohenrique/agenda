# Valores públicos; seguros para bundle do navegador.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=public-anon-key-from-supabase-status
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-for-local-jobs-only
BOOKING_TOKEN_PEPPER=replace-with-at-least-32-random-characters
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Worker interno. Provedor real fica para configuração do ambiente.
# dry-run é somente local; produção exige webhook configurado.
NOTIFICATION_WORKER_SECRET=replace-with-at-least-32-random-characters
NOTIFICATION_MODE=dry-run
NOTIFICATION_WEBHOOK_URL=https://notifications.example.com/events
NOTIFICATION_WEBHOOK_SECRET=replace-with-provider-secret

# WhatsApp Business Platform. Mock funciona sem conta Meta.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_WABA_ID=
WHATSAPP_SIMULATOR_ENABLED=true
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_WORKER_SECRET=replace-with-at-least-32-random-characters

# Interpretação por LLM no modo texto (opcional). `none` mantém só as regras.
# A chave é exclusivamente de servidor; qualquer falha do provedor cai nas
# regras em silêncio. Groq: https://console.groq.com (tier gratuito).
WHATSAPP_LLM_PROVIDER=none
WHATSAPP_LLM_API_KEY=
WHATSAPP_LLM_MODEL=
WHATSAPP_LLM_TIMEOUT_MS=
